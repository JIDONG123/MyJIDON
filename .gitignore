# =============================================================================
# 智能实训作业批改管理系统 — Git 忽略规则
# 适配：backend / frontend / docker / docs + Docker Compose 部署
# 说明：保留全部源码、SQL、部署配置与文档；忽略本地私密与运行时产物
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 环境变量与私密配置（强制忽略，仅保留模板）
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

# 子目录中的本地环境文件（如 backend/.env）
**/.env
**/.env.*
!**/.env.example

# -----------------------------------------------------------------------------
# 2. Node.js 依赖与构建产物
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/

# 前端 Vite 打包目录
frontend/dist/

# 其它常见构建输出（若后续引入 TypeScript / 库模式）
**/build/
**/.next/
**/.nuxt/
**/.output/
**/.svelte-kit/

# 包管理器调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# 3. 运行时目录：日志、上传、临时文件
# -----------------------------------------------------------------------------
# 日志目录与日志文件（保留 .gitkeep 占位）
logs/
**/logs/**
!**/logs/**/
!**/logs/**/.gitkeep

*.log
*.log.*

# 上传目录（学生作业、头像等运行时文件）
uploads/
**/uploads/**
!**/uploads/**/
!**/uploads/**/.gitkeep

# 临时目录
tmp/
temp/
**/tmp/**
**/temp/**
!**/tmp/**/
!**/tmp/**/.gitkeep
!**/temp/**/
!**/temp/**/.gitkeep

# 导出、报告、生成物（运行时）
exports/
reports/
generated/
cache/
**/exports/**
!**/exports/**/
!**/exports/**/.gitkeep

# 全局保留空目录占位文件（不屏蔽 .gitkeep）
!.gitkeep

# -----------------------------------------------------------------------------
# 4. Docker 与本地部署运行时数据
# -----------------------------------------------------------------------------
# Compose 命名卷在宿主机上的常见本地映射目录（若改为 bind mount）
docker/data/
docker/mysql/
docker/mariadb/
docker/redis/
docker/volumes/

# 本地数据库 / 缓存数据目录（勿提交真实数据）
data/
mariadb_data/
redis_data/
mysql_data/

# Docker 构建缓存与本地覆盖
.docker/
**/.docker/

# -----------------------------------------------------------------------------
# 5. 测试覆盖率、工具缓存、进程管理
# -----------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
*.lcov

.cache/
**/.cache/
.parcel-cache/
.turbo/
.vite/
**/.vite/

pids/
*.pid
*.seed
*.pid.lock

# -----------------------------------------------------------------------------
# 6. 编辑器与 IDE
# -----------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/
.fleet/

# -----------------------------------------------------------------------------
# 7. 操作系统与杂项
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Windows / Linux 临时与备份
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# 压缩包与导出物（本地打包，非源码）
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# 本地密钥与证书（勿入库）
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
*.crt.local

# -----------------------------------------------------------------------------
# 8. 明确保留（注释说明，Git 不读取注释，仅供维护者参考）
# -----------------------------------------------------------------------------
# ✓ 保留：backend/ frontend/ deploy/ docs/ 全部源代码
# ✓ 保留：backend/sql/*.sql、deploy/docker/*、scripts/*.sh
# ✓ 保留：docker-compose.yml、docker-compose.host.yml、.env.example、.env.host.example
# ✓ 保留：.env.example、README.md、package.json、package-lock.json
# ✓ 保留：.gitkeep（见上文 ! 规则）
