# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  本文件仅为「配置模板」，任何程序都不会读取本文件。                          ║
# ║  请复制为项目根目录 .env 后修改（仅此一份，Docker 与本地后端共用）：         ║
# ║    Linux/macOS:  cp .env.example .env                                       ║
# ║    Windows CMD: copy .env.example .env                                      ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
#
# 部署方式：
#   • Docker（大赛推荐）：保持 DB_HOST=mariadb、REDIS_HOST=redis，执行 docker compose up
#   • 本地裸机开发：将 DB_HOST 改为 127.0.0.1，REDIS_URL 改为 redis://127.0.0.1:6379/0
#     在 backend 目录 npm run start 或 npm run start:cluster

# ---------- Docker Compose 端口映射（仅 compose 使用，Node 不读） ----------
BACKEND_PORT=3000
FRONTEND_PORT=5173
MARIADB_PORT=3306
REDIS_PORT=6379

# ---------- MariaDB（mysql2 驱动，协议兼容 MySQL，端口 3306） ----------
# Docker: mariadb   |  本机: 127.0.0.1
DB_HOST=mariadb
DB_USER=sg_user
DB_PASSWORD=sg_pass_change_me
DB_NAME=smart_grading_system
MARIADB_ROOT_PASSWORD=root_change_me

# ---------- Redis + Socket.IO 跨进程（集群必须，禁止仅内存模式） ----------
# Docker: redis  |  本机: 127.0.0.1
REDIS_ENABLED=1
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
SOCKET_IO_REDIS_KEY=sg:socket.io
SOCKET_IO_REDIS_DEV_PROBE=0

# ---------- 后端 Node（Docker 容器与本地启动均读取） ----------
NODE_ENV=production
PORT=3000
JWT_SECRET=请替换为至少32位随机字符串
USE_CLUSTER=1
CLUSTER_WORKERS=2

# ---------- 龙芯 LoongArch 可选镜像（默认留空） ----------
# NODE_IMAGE=loongnix/node:20
# MARIADB_IMAGE=loongnix/mariadb:11
# REDIS_IMAGE=loongnix/redis:7

# =============================================================================
# 可选（大赛环境建议保持注释）
# =============================================================================
# DB_POOL_CONNECTION_LIMIT=50
# DB_POOL_QUEUE_LIMIT=100
# SOCKET_IO_REDIS_CONNECT_MS=8000
# UPLOAD_PATH=
# CACHE_KEY_PREFIX=sg:
# BCRYPT_ROUNDS=10
# RATE_LIMIT_API_WINDOW_MS=60000
# RATE_LIMIT_API_MAX=300
# ZIP_MAX_UPLOAD_BYTES=52428800
# USE_LANGCHAIN_GRADING=1
# LANGCHAIN_SUBMISSION_MAX_CHARS=14000
# CACHE_TTL_LC_STEP2=1800
