# =============================================================================
# 智能实训批改系统 — 云服务器 Docker 部署环境变量模板
# 适用：阿里云 / 腾讯云 ECS（amd64，推荐 4核8G）
# 用法：cp .env.example .env && docker compose up -d --build
# 详细说明：docs/05-configuration.md | 部署步骤：docs/04-deployment.md
# =============================================================================

NODE_ENV=production
ENABLE_BACKEND_CORS=0

# =============================================================================
# 一、部署档位（默认 4c8g = medium）
# =============================================================================
DEPLOY_PROFILE=medium
HTTP_PORT=80
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m
NEO4J_MEM_LIMIT=2g
BACKEND_MEM_LIMIT=1536m
REDIS_MAXMEMORY=256mb

# =============================================================================
# 二、MariaDB（Docker 内网服务名 mariadb）
# =============================================================================
DB_HOST=mariadb
DB_PORT=3306
DB_USER=sg_user
DB_PASSWORD=sg_pass_change_me
DB_NAME=smart_grading_system
MARIADB_ROOT_PASSWORD=root_change_me

# =============================================================================
# 三、Redis
# =============================================================================
REDIS_ENABLED=1
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# =============================================================================
# 四、后端 Node
# =============================================================================
PORT=8080
JWT_SECRET=请替换为至少32位随机字符串
# JWT 有效期（默认 8h）；同时作为单端登录 Redis 会话 TTL
# JWT_EXPIRES_IN=8h

# 单端登录：同一账号仅保留一个有效会话（新登录踢旧端）
# 设为 0 或 false 可关闭，允许多浏览器/多设备同时在线（本地调试）
SINGLE_SESSION_ENABLED=1
# 异地登录时是否通过 Socket 向旧端推送 auth:kicked（HTTP 鉴权仍会踢下线）
SESSION_KICK_NOTIFY_ENABLED=1

# LLM 主配置在管理端「系统设置」：llm_api_base / llm_api_key / llm_model

# =============================================================================
# 五、LangChain 多步 AI 批改（读 backend/utils/langchainGradingService.js、aiGrading.js）
# 设为 1 启用链式编排；不设或非 1 则仍为单步 gradeWithLlm
# =============================================================================
USE_LANGCHAIN_GRADING=1
# 提交正文进入链前的最大字符数（默认 14000）
LANGCHAIN_SUBMISSION_MAX_CHARS=14000
# 第 2 步「任务+RAG 对齐」结果 Redis 缓存秒数；0 表示关闭该缓存
CACHE_TTL_LC_STEP2=1800

# =============================================================================
# 五（续）、AI 异步批改队列（BullMQ item-level + Legacy Redis List fallback）
# HTTP 只入队；须单独运行批改 Worker（与 backend 容器/进程分离）
# BULLMQ_ENABLED=1 → npm run worker:grading（BullMQ）
# BULLMQ_ENABLED=0 → npm run worker:grading:legacy（Redis List）
# 生产必须 REDIS_ENABLED=1；勿同时启动两种 Worker
# 健康检查：GET /api/grading/worker-health
# =============================================================================
BULLMQ_ENABLED=1
BULLMQ_PREFIX=smart-grading
AI_GRADING_QUEUE_NAME=ai-grading
AI_GRADING_JOB_CONCURRENCY=2
AI_GRADING_ITEM_CONCURRENCY=2
AI_GRADING_TIMEOUT_MS=90000
AI_GRADING_RETRY=1
AI_GRADING_BACKOFF_MS=2000
AI_GRADING_RAG_CACHE_TTL=1800
AI_GRADING_TASK_CONTEXT_CACHE_TTL=1800
# 批改 job 完成后异步触发知识图谱构建（可选）
# KG_ASYNC_AFTER_GRADING_JOB=0
# Legacy Redis List 队列键名（BULLMQ_ENABLED=0 时）
# GRADING_JOB_QUEUE_KEY=sg:grading:jobs
# Worker BRPOP 阻塞超时秒数（Legacy 模式，默认 5）
# GRADING_JOB_BRPOP_SEC=5

# =============================================================================
# 五（续2）、代码运行 Worker（在线实训 / 任务代码检查）
# 独立进程 workers/codeRunnerWorker.js；Express 主进程不得 spawn 学生代码
# 默认 CODE_RUNNER_ENABLED=0，不影响现有 Staging 主流程
# =============================================================================
# CODE_RUNNER_ENABLED=0
# CODE_RUNNER_MODE=docker
# docker | host（龙芯/麒麟宿主机用 host + code_runner 用户）
# CODE_RUNNER_JOBS_ROOT=/var/lib/smart-grading/code-runner/jobs
# CODE_RUNNER_USER=code_runner
# CODE_RUNNER_QUEUE_KEY=sg:code_run:jobs
# CODE_RUNNER_BRPOP_SEC=5
# CODE_RUNNER_DEFAULT_TIMEOUT_SEC=10
# CODE_RUNNER_MAX_OUTPUT_BYTES=65536
# CODE_RUNNER_STALE_MINUTES=10
# RATE_LIMIT_CODE_RUN_WINDOW_MS=60000
# RATE_LIMIT_CODE_RUN_MAX=30
# Docker 镜像（本地开发，与您已准备环境一致）
# CODE_RUNNER_IMAGE_PYTHON=python:3.11-slim
# CODE_RUNNER_IMAGE_NODE=node:20-slim
# CODE_RUNNER_IMAGE_C=gcc:13
# CODE_RUNNER_IMAGE_CPP=gcc:13
# CODE_RUNNER_IMAGE_JAVA=eclipse-temurin:21-jdk

# =============================================================================
# 五（续3）、在线实训 AI 代码点评（Phase F1，练习参考分，非正式成绩）
# 默认关闭；开发/演示时设 ONLINE_PRACTICE_AI_REVIEW_ENABLED=1
# 依赖 LLM 系统配置；不复用 grading Worker / Code Runner Worker
# =============================================================================
# ONLINE_PRACTICE_AI_REVIEW_ENABLED=0
# ONLINE_PRACTICE_AI_REVIEW_TIMEOUT_MS=45000
# ONLINE_PRACTICE_AI_REVIEW_COOLDOWN_SEC=60

# Socket.IO 跨进程适配器（使用官方 redis 包 + @socket.io/redis-adapter；业务缓存仍用 ioredis）
# SOCKET_IO_REDIS_KEY=sg:socket.io
# SOCKET_IO_REDIS_CONNECT_MS=8000

# 开发环境无 REDIS_URL/HOST 时会短时探测 127.0.0.1；设为 0 可关闭
# SOCKET_IO_REDIS_DEV_PROBE=0
# CACHE_KEY_PREFIX=sg:
# CACHE_TTL_USER_ME=120
# CACHE_TTL_CLASSES=180
# CACHE_TTL_TEACHING_OVERVIEW=120
# CACHE_TTL_TASK=120
# CACHE_TTL_DASHBOARD=60
# CACHE_TTL_SETTINGS=300
# CACHE_TTL_QB_EXAM=90

# 题库 / 考试限流（进程内）
# RATE_LIMIT_QB_EXAM_SUBMIT_WINDOW_MS=60000
# RATE_LIMIT_QB_EXAM_SUBMIT_MAX=20
# RATE_LIMIT_QB_EXAM_AUTOSAVE_WINDOW_MS=60000
# RATE_LIMIT_QB_EXAM_AUTOSAVE_MAX=120
# RATE_LIMIT_QB_CODE_RUN_WINDOW_MS=60000
# RATE_LIMIT_QB_CODE_RUN_MAX=40

# 题库成绩 AES 密钥（可选；不设则从 JWT_SECRET 派生）
# QB_SCORE_ENC_KEY=
# 编程题试运行：Python 可执行文件（可选；Windows 默认 python，Linux 默认 python3）
# QB_PYTHON_BIN=

# 密码哈希（bcrypt 成本因子，默认 10；bcrypt 内置随机盐，写入哈希串）
# BCRYPT_ROUNDS=10

# 多进程集群（生产环境建议开启）
# USE_CLUSTER=1
# CLUSTER_WORKERS=2

# 限流（进程内滑动窗口；可按需调大）
# RATE_LIMIT_API_WINDOW_MS=60000
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_LOGIN_WINDOW_MS=60000
# RATE_LIMIT_LOGIN_MAX=30
# RATE_LIMIT_GRADING_WINDOW_MS=60000
# RATE_LIMIT_GRADING_MAX=20
# RATE_LIMIT_SUBMIT_WINDOW_MS=60000
# RATE_LIMIT_SUBMIT_MAX=40
# RATE_LIMIT_BATCH_WINDOW_MS=600000
# RATE_LIMIT_BATCH_MAX=10

# 重复提交防抖窗口（毫秒）
# POST_DEDUPE_WINDOW_MS=3000

# ZIP 源码包安全解压（adm-zip）
# ZIP_MAX_UPLOAD_BYTES=52428800
# ZIP_MAX_ENTRY_COUNT=400
# ZIP_MAX_UNCOMPRESSED_TOTAL=104857600
# ZIP_MAX_ENTRY_UNCOMPRESSED=20971520
# ZIP_MAX_ENTRY_COMPRESSED=26214400
# ZIP_MAX_OUTPUT_CHARS=1200000
# ZIP_MAX_COMPRESSION_RATIO=200

# =============================================================================
# 六、Neo4j 知识图谱
# =============================================================================
KG_NEO4J_ENABLED=1
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_change_me
NEO4J_DATABASE=neo4j
KG_RECONCILE_ENABLED=1
KG_RECONCILE_INTERVAL_MS=21600000
KG_SEMANTIC_MIN_SIM=0.72
KG_NEO4J_BATCH=150

# =============================================================================
# 七、通义千问 / 向量 API
# =============================================================================
QWEN_VL_API_KEY=
QWEN_VL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-plus
# DASHSCOPE_API_KEY=
# EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 数据库连接池 / 上传路径（可选）
# DB_POOL_CONNECTION_LIMIT=50
# DB_POOL_QUEUE_LIMIT=100
# UPLOAD_PATH=

# =============================================================================
# 八、Docker 镜像覆盖（可选，默认 Docker Hub 官方 amd64）
# =============================================================================
# NODE_IMAGE=node:20-alpine
# NGINX_IMAGE=nginx:1.24-alpine
# MARIADB_IMAGE=mariadb:10.11
# REDIS_IMAGE=redis:7-alpine
# NEO4J_IMAGE=neo4j:5.26-community

# =============================================================================
# 九、SMTP 邮件（找回密码，须 Redis）
# =============================================================================
# 本地开发填 Vite 地址；生产填 Nginx 对外 URL（勿带末尾 /）
PUBLIC_APP_URL=http://localhost:5173
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=your@email.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=龙芯智训 <your@email.com>
# PWD_RESET_TOKEN_TTL_SEC=900
# PWD_RESET_RATE_TTL_SEC=120
# CAPTCHA_TTL_SEC=300
