[Unit]
Description=龙芯智训 - AI 批改 BullMQ Worker (item-level 队列消费)
Documentation=file://__INSTALL_ROOT__/README.md
After=network-online.target smart-grading-backend.service
Wants=network-online.target
# 依赖 Redis；MariaDB 由 bootstrap 连接，与 backend 共用 .env

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__INSTALL_ROOT__/backend
EnvironmentFile=__INSTALL_ROOT__/.env
Environment=NODE_ENV=production
ExecStart=__NODE_BIN__ workers/gradingBullmqWorker.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
