[Unit]
Description=龙芯智训 - 代码运行 Worker (Redis 队列消费)
Documentation=file://__INSTALL_ROOT__/README.md
After=network-online.target smart-grading-backend.service
Wants=network-online.target
# 依赖 Redis；MariaDB 由 bootstrap 连接，与 backend 共用 .env
# host 模式需预装 python3/node/gcc/javac 及 code_runner 用户（install-autostart.sh 可初始化）

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__INSTALL_ROOT__/backend
EnvironmentFile=__INSTALL_ROOT__/.env
Environment=NODE_ENV=production
ExecStart=__NODE_BIN__ workers/codeRunnerWorker.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
