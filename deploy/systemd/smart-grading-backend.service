[Unit]
Description=龙芯智训 - 后端 API (Node cluster)
Documentation=file://__INSTALL_ROOT__/README.md
After=network-online.target docker.service
Wants=network-online.target docker.service
# MariaDB / Redis 服务名因发行版而异，install 脚本会尝试启用

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__INSTALL_ROOT__/backend
EnvironmentFile=__INSTALL_ROOT__/.env
Environment=NODE_ENV=production
ExecStart=__NODE_BIN__ cluster.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
